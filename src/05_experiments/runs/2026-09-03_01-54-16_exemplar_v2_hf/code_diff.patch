-        """Route thận trọng nhất trong các nhãn trúng."""
-        if not self.hits:
-            return "C_llm"
-        order = {"D_human": 3, "C_llm": 2, "B_known": 1, "A_template": 0}
-        return max((h.route for h in self.hits), key=lambda r: order.get(r, 2))
