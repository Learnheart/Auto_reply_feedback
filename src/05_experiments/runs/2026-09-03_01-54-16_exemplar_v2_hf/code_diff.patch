+    def _h(t: str) -> str:
+        return hashlib.blake2b(f"hf:{model_name}\x00{t}".encode(), digest_size=16).hexdigest()
+
+    def enc(texts: Sequence[str]) -> np.ndarray:
+        texts = list(texts)
